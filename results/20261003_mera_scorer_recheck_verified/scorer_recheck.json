    {
      "sha": "88278442298c3f76ed25ef453492c0232da6e070",
      "date": "2026-09-11T12:18:28Z",
      "message": "Register remove_whitespace_and_nones only if the harness has not\n\nlm-eval 0.4.13 ships a built-in filter under this alias, and its registry\nrefuses a second class for a name already taken:\n\n    ValueError: 'filter' alias 'remove_whitespace_and_nones' already registered\n\nwhich takes down agro_bench, med_bench and aqua_bench -- the whole benchmark --\nthe moment the submodule moves to feat/text_benches. Falling through to the\nbuilt-in is safe: the two apply() bodies are the same operation, None -> \"\" and\notherwise lstrip(). MERA_United already carries this guard.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>",
      "url": "https://github.com/MERA-Evaluation/MERA_Industrial/commit/88278442298c3f76ed25ef453492c0232da6e070"
    },
    {
      "sha": "4733b8b1c81da8c5527dd7946b4b3d7911ff8384",
      "date": "2025-10-09T11:16:45Z",
      "message": "add insudtrial tasks (agro, aqua, med) and scripts\n\n---------\n\nCo-authored-by: artemorloff <arorlov97@gmail.com>\nCo-authored-by: Nikolay.Ivanov <nikolayivanov@MacBook-Pro-Nikolay.local>",
      "url": "https://github.com/MERA-Evaluation/MERA_Industrial/commit/4733b8b1c81da8c5527dd7946b4b3d7911ff8384"
    }
