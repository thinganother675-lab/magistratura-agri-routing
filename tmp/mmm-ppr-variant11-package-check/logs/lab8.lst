  20  mk_time_80                   1400.00000000       16.80000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  21  mk_time_90                   1400.00000000       18.90000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  22  mk_time_110                  1400.00000000       23.10000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  23  cy_time_80                   1400.00000000       21.00000000       14.40000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  24  cy_time_90                   1400.00000000       21.00000000       16.20000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  25  cy_time_110                  1400.00000000       21.00000000       19.80000000    24000.00000000    27000.00000000   138000.00000000    25000.00000000
  26  milk_price_90                1400.00000000       21.00000000       18.00000000    21600.00000000    27000.00000000   138000.00000000    25000.00000000
  27  milk_price_110               1400.00000000       21.00000000       18.00000000    26400.00000000    27000.00000000   138000.00000000    25000.00000000
  28  kefir_price_90               1400.00000000       21.00000000       18.00000000    24000.00000000    24300.00000000   138000.00000000    25000.00000000
  29  kefir_price_110              1400.00000000       21.00000000       18.00000000    24000.00000000    29700.00000000   138000.00000000    25000.00000000
  30  cream_price_90               1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   124200.00000000    25000.00000000
  31  cream_price_110              1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   151800.00000000    25000.00000000
  32  yogurt_price_90              1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    22500.00000000
  33  yogurt_price_110             1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    27500.00000000
