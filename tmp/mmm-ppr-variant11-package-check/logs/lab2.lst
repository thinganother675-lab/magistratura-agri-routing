Laboratory 2 - variant 11 - milk production LP
C o m p i l a t i o n


      Draft calculation prepared at student's request, pending teacher's prior
      approval of the mathematical formulation required by the course.
      Units: centners/day, hours/day, RUB/day. Extra product: curd bars.
      Run from this directory: gams lab2.gms
   8  Set j /milk,kefir,cream,curd_bars/;
   9  Parameter price(j) /milk 2400,kefir 2700,cream 13800,curd_bars 7500/,
  10            input(j) /milk 1.01,kefir 1.01,cream 9.45,curd_bars 16/;
  11  Positive Variable x(j);
  12  Variable revenue;
  13  Equations objective,raw,mkLine,creamLine,curdLine;
  14  objective.. revenue =e= sum(j,price(j)*x(j));
  15  raw.. sum(j,input(j)*x(j)) =l= 140;
  16  mkLine.. x('milk')/5+x('kefir')/6 =l= 21;
  17  creamLine.. x('cream')/0.3 =l= 16;
  18  curdLine.. x('curd_bars')/0.25 =l= 17;
  19  Model production /all/;
  20  option lp=cplex,limrow=0,limcol=0;
  21  solve production using lp maximizing revenue;
  22  abort$(production.modelstat<>1 or production.solvestat<>1) 'LP failed';
  23  Scalar violation;
  24  violation=max(0,sum(j,input(j)*x.l(j))-140,
  25   x.l('milk')/5+x.l('kefir')/6-21,x.l('cream')/.3-16,
  26   x.l('curd_bars')/.25-17,-smin(j,x.l(j)));
  27  abort$(violation>1e-7) 'Infeasible LP output',violation;
  28  File f /'../results/lab2_gams.csv'/;
  29  f.pw=32767;
  30  put f 'product,x_centner,revenue_rub,modelstat,solvestat' /;
  31  loop(j,put j.tl:0 ',' x.l(j):0:10 ',' revenue.l:0:10 ',' production.modelstat:0:0 ',' production.solvestat:0:0 /;);
  32  putclose f;
  33  File g /'../results/lab2_gams_resources.csv'/;
  34  put g 'resource,used,available,shadow_price' /;
  35  put 'raw,' sum(j,input(j)*x.l(j)):0:10 ',140,' raw.m:0:10 /;
  36  put 'milk_kefir_hours,' (x.l('milk')/5+x.l('kefir')/6):0:10 ',21,' mkLine.m:0:10 /;
  37  put 'cream_hours,' (x.l('cream')/.3):0:10 ',16,' creamLine.m:0:10 /;
  38  put 'curd_hours,' (x.l('curd_bars')/.25):0:10 ',17,' curdLine.m:0:10 /;
  39  putclose g;
  40  display x.l,revenue.l,raw.m,mkLine.m,creamLine.m,curdLine.m;


