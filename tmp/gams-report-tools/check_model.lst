   5   
   6  Parameters
   7      price(j) /milk 2.4, kefir 2.7, cream 13.8, skim 0.79/
   8      capacity(r) /rawmilk 140, mainline 21, creamline 16, assortment 0/;
   9   
  10  Table a(r,j)
  11                    milk       kefir       cream        skim
  12      rawmilk       1.01        1.01        9.45        0.31
  13      mainline      0.20        0.00        0.00        0.00
  14      creamline     0.00        0.00        0.00        0.00
  15      assortment    0.00        1.00        0.00       -2.00;
  16   
  17  a('mainline','kefir') = 1/6;
  18  a('mainline','skim') = 1/6;
  19  a('creamline','cream') = 1/0.3;
  20   
  21  Positive Variable x(j);
  22  Variable revenue;
  23  Equations objective, resource(r);
  24   
  25  objective.. revenue =e= sum(j, price(j)*x(j));
  26  resource(r).. sum(j, a(r,j)*x(j)) =l= capacity(r);
  27   
  28  Model dairy /all/;
  29  option lp=cplex;
  30  solve dairy using lp maximizing revenue;
  31  display x.l, revenue.l;
  32  abort$(dairy.modelstat <> 1 or dairy.solvestat <> 1) 'Status check failed';
  33  abort$(abs(revenue.l-321.517777777778)>1e-8) 'Revenue check failed';
  34  abort$(abs(x.l('milk'))>1e-8 or abs(x.l('kefir')-84)>1e-8
  35      or abs(x.l('cream')-4214/945)>1e-8 or abs(x.l('skim')-42)>1e-8)
  36      'Product check failed';
  37  abort$(smax(r,sum(j,a(r,j)*x.l(j))-capacity(r))>1e-8) 'Feasibility failed';
  38  File results /'C:/sarychev/Codex/magistratura/coursework/gams-2026/lab2-variant8/gams_result.csv'/;
  39  put results 'milk,kefir,cream,skim,revenue_thousand_rub,modelstat,solvestat'/;
  40  put x.l('milk'):0:12 ',' x.l('kefir'):0:12 ',' x.l('cream'):0:12 ','
  41      x.l('skim'):0:12 ',' revenue.l:0:12 ',' dairy.modelstat:0:0 ',' dairy.solvestat:0:0/;
  42  putclose results;
