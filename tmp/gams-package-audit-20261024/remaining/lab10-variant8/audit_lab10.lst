  31  ;
  32  Parameter target(r), result(m,*), weights(m,j), used(m,r);
  33  Positive Variable lambda(j);
  34  Variable phi;
  35  phi.lo=1;
  36  Equations inputLimit(r), outputTarget(r), convexity;
  37  inputLimit(inputs).. sum(j, data(j,inputs)*lambda(j)) =l= target(inputs);
  38  outputTarget(outputs).. sum(j, data(j,outputs)*lambda(j)) =g= phi*target(outputs);
  39  convexity.. sum(j,lambda(j)) =e= 1;
  40  Model dea /all/;
  41  option lp=cplex;
  42  File scores /efficiencies.csv/, peers /peers.csv/, source /input_data.csv/;
  43  put source 'firm,y1,y2,x1,x2' /;
  44  loop(j, put source j.tl:0 ',' data(j,'y1'):0:0 ',' data(j,'y2'):0:0 ','
  45      data(j,'x1'):0:0 ',' data(j,'x2'):0:0 /;);
  46  putclose source;
  47  put scores 'firm,phi,efficiency,modelstat,solvestat,max_violation' /;
  48  put peers 'firm,peer,lambda' /;
  49  loop(m,
  50      target(r)=data(m,r);
  51      solve dea using lp maximizing phi;
  52      abort$(dea.modelstat<>1 or dea.solvestat<>1) 'DEA solve failed',m;
  53      result(m,'phi')=phi.l;
  54      result(m,'efficiency')=1/phi.l;
  55      result(m,'modelstat')=dea.modelstat;
  56      result(m,'solvestat')=dea.solvestat;
  57      weights(m,j)=lambda.l(j);
  58      used(m,r)=sum(j,data(j,r)*lambda.l(j));
  59      result(m,'violation')=max(0,smax(inputs,used(m,inputs)-target(inputs)),
  60         smax(outputs,phi.l*target(outputs)-used(m,outputs)),
  61         abs(sum(j,lambda.l(j))-1),1-phi.l,-smin(j,lambda.l(j)));
  62      abort$(result(m,'violation')>1e-6) 'DEA residual failed',m;
  63      put scores m.tl:0 ',' phi.l:0:15 ',' result(m,'efficiency'):0:15 ','
  64         dea.modelstat:0:0 ',' dea.solvestat:0:0 ',' result(m,'violation'):0:15 /;
  65      loop(j$(lambda.l(j)>1e-8),put peers m.tl:0 ',' j.tl:0 ',' lambda.l(j):0:15 /;);
  66  );
  67  putclose scores;
  68  putclose peers;
  69  display result,weights,used;


