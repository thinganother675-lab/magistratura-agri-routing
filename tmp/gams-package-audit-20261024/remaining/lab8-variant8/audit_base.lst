 152  loop(j,put 'ep_' j.tl:0 ',';);
 153  loop(j,put 'ea_' j.tl:0 ',';);
 154  loop(j,put 'qmin_' j.tl:0 ',';);
 155  loop((r,j),put 'speed_' r.tl:0 '_' j.tl:0 ',';);
 156  loop(j,put 'effective_price_' j.tl:0 ',';);
 157  loop(j,put 'effective_input_' j.tl:0 ',';);
 158  loop(j,put 'bound_marginal_' j.tl:0 '_rub_per_t,';);
 159  put 'q0_t' /;
 160  loop(s,
 161      put s.tl:0 ',';
 162      loop(cf,put conditions(s,cf):0:12 ',';);
