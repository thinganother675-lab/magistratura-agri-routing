INCLUDE    C:\sarychev\Codex\magistratura\tmp\gams-package-audit-20261024\remaining\lab8-variant8\model.inc
   3  Sets
   4      j /milk, kefir, cream, curds/
   5      r /mainline, creamline, curdsline/;
   6   
   7  Parameters
   8      p0(j) /milk 24000, kefir 27000, cream 138000, curds 78000/
   9      a0(j) /milk 1.01, kefir 1.01, cream 9.45, curds 14/
  10      ep(j) /milk -.034, kefir -.022, cream -.022, curds -.027/
  11      ea(j) /milk -.017, kefir -.012, cream -.011, curds -.010/
  12      qmin(j) /milk 25, kefir 30, cream 1.5, curds 1.25/
  13      hours(r) /mainline 21, creamline 18, curdsline 18/
  14      price(j), time(r,j);
  15   
  16  Table speed(r,j)
  17                  milk    kefir    cream    curds
  18      mainline      50       60        0        0
  19      creamline      0        0        3        0
  20      curdsline      0        0        0      2.5;
  21   
  22  Scalar rawCapacity /1400/, q0 /100/;
  23  price(j) = p0(j);
  24  time(r,j)$speed(r,j) = 1/speed(r,j);
  25   
  26  Positive Variable q(j);
  27  Variable revenue;
  28  Equations objective, raw, line(r);
  29   
  30  objective.. revenue =e= sum(j,price(j)*q0*rPower(q(j)/q0,1+ep(j)))/1e6;
  31  raw.. sum(j,a0(j)*q0*rPower(q(j)/q0,1+ea(j))) =l= rawCapacity;
  32  line(r).. sum(j,time(r,j)*q(j)) =l= hours(r);
  33   
  34  Model dairy /all/;
  35  q.lo(j) = qmin(j);
  36  option nlp=conopt, optcr=1e-9, optca=1e-9, reslim=60;
  37   
  38   
  39  Set s /base/;
  40  Table conditions(s,*)
  41            raw_t  mk_hours  cream_hours  curds_hours  p_milk  p_kefir  p_cream  p_curds
  42      base   1400        21           18           18   24000    27000   138000    78000;
  43   
INCLUDE    C:\sarychev\Codex\magistratura\tmp\gams-package-audit-20261024\remaining\lab8-variant8\run_cases.inc
  46  Sets st /start1*start3/, pass /normal, strict/;
  47  Table initial(st,j)
  48               milk   kefir  cream  curds
  49      start1     25      30    1.5   1.25
  50      start2    300     500     30      5
  51      start3    800     100     45     35;
  52   
  53  Parameters result(s,*), bestQ(s,j), run(s,st,*), runQ(s,st,j),
  54      startQ(s,st,j), startUpper(j), used(r), bestShadow(s,*), bestBound(s,j), basePrice(s,j), baseInput(s,j);
  55  Scalars best, spread, objSpread, qSpread, violation, rawUsed, boundViolation,
  56      rawViolation, lineViolation, objectiveCheck, accepted;
  57   
  58  loop(s,
  59      rawCapacity = conditions(s,'raw_t');
  60      hours('mainline') = conditions(s,'mk_hours');
  61      hours('creamline') = conditions(s,'cream_hours');
  62      hours('curdsline') = conditions(s,'curds_hours');
  63      price('milk') = conditions(s,'p_milk');
  64      price('kefir') = conditions(s,'p_kefir');
  65      price('cream') = conditions(s,'p_cream');
  66      price('curds') = conditions(s,'p_curds');
  67      startUpper(j) = smin(r$speed(r,j),speed(r,j)*hours(r));
  68      abort$(smin(j,startUpper(j)-qmin(j))<0) 'Lower bound exceeds line capacity',s;
  69      spread = 0;
  70      loop(pass$(ord(pass)=1 or spread>.001),
  71          dairy.optfile = ord(pass);
  72          best = -inf;
  73          loop(st,
  74              q.l(j) = min(startUpper(j),max(qmin(j),initial(st,j)));
  75              startQ(s,st,j) = q.l(j);
  76              q.m(j) = 0;
  77              revenue.l = sum(j,price(j)*q0*rPower(q.l(j)/q0,1+ep(j)))/1e6;
  78              revenue.m = 0; raw.m = 0; line.m(r) = 0; objective.m = 0;
  79              solve dairy using nlp maximizing revenue;
  80              rawUsed = sum(j,a0(j)*q0*rPower(q.l(j)/q0,1+ea(j)));
  81              used(r) = sum(j,time(r,j)*q.l(j));
  82              rawViolation = max(0,rawUsed-rawCapacity);
  83              lineViolation = smax(r,max(0,used(r)-hours(r)));
  84              boundViolation = smax(j,max(0,qmin(j)-q.l(j),q.l(j)-q.up(j)));
  85              violation = max(rawViolation,lineViolation,boundViolation);
  86              objectiveCheck = abs(revenue.l*1e6-sum(j,price(j)*q0*rPower(q.l(j)/q0,1+ep(j))));
  87              accepted = ((dairy.modelstat=1 or dairy.modelstat=2) and dairy.solvestat=1 and violation<1e-5 and objectiveCheck<.01);
  88              run(s,st,'objective_rub') = revenue.l*1e6;
  89              run(s,st,'modelstat') = dairy.modelstat;
  90              run(s,st,'solvestat') = dairy.solvestat;
  91              run(s,st,'max_violation') = violation;
  92              run(s,st,'raw_violation_t') = rawViolation;
  93              run(s,st,'line_violation_hours') = lineViolation;
  94              run(s,st,'bound_violation_t') = boundViolation;
  95              run(s,st,'objective_check_rub') = objectiveCheck;
  96              run(s,st,'accepted') = accepted;
  97              run(s,st,'pass') = ord(pass);
  98              runQ(s,st,j) = q.l(j);
  99              if(accepted and revenue.l>best,
 100                  best = revenue.l;
 101                  bestQ(s,j) = q.l(j);
 102                  result(s,'objective_rub') = revenue.l*1e6;
 103                  result(s,'modelstat') = dairy.modelstat;
 104                  result(s,'solvestat') = dairy.solvestat;
 105                  result(s,'max_violation') = violation;
 106                  result(s,'raw_used_t') = rawUsed;
 107                  result(s,'mk_used_hours') = used('mainline');
 108                  result(s,'cream_used_hours') = used('creamline');
 109                  result(s,'curds_used_hours') = used('curdsline');
 110                  result(s,'raw_violation_t') = rawViolation;
 111                  result(s,'mk_violation_hours') = max(0,used('mainline')-hours('mainline'));
 112                  result(s,'cream_violation_hours') = max(0,used('creamline')-hours('creamline'));
 113                  result(s,'curds_violation_hours') = max(0,used('curdsline')-hours('curdsline'));
 114                  result(s,'bound_violation_t') = boundViolation;
 115                  result(s,'objective_check_rub') = objectiveCheck;
 116                  bestShadow(s,'raw') = raw.m*1e6;
 117                  loop(r,bestShadow(s,r) = line.m(r)*1e6;);
 118                  bestBound(s,j) = q.m(j)*1e6;
 119                  basePrice(s,j) = price(j)*rPower(q.l(j)/q0,ep(j));
 120                  baseInput(s,j) = a0(j)*rPower(q.l(j)/q0,ea(j));
 121              );
 122          );
 123          abort$(smin(st,run(s,st,'accepted'))=0) 'At least one start failed. Inspect listing.',s,run;
 124          objSpread = (smax(st,run(s,st,'objective_rub'))-smin(st,run(s,st,'objective_rub')))/max(1,abs(result(s,'objective_rub')));
 125          qSpread = smax(j,(smax(st,runQ(s,st,j))-smin(st,runQ(s,st,j)))/max(1,abs(bestQ(s,j))));
 126          spread = max(objSpread,qSpread);
 127          result(s,'pass') = ord(pass);
 128      );
 129      result(s,'spread_relative') = spread;
 130      result(s,'objective_spread_relative') = objSpread;
 131      result(s,'q_spread_relative') = qSpread;
 132      abort$(spread>.001) 'Starts still differ by more than 0.1 percent after stricter retry',s,spread;
 133  );
