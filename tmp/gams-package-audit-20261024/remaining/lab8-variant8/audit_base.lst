 164      loop(rf,put result(s,rf):0:12 ',';);
 165      put 'LOCAL_OPTIMUM_FOUND,' bestShadow(s,'raw'):0:12 ',';
 166      loop(r,put bestShadow(s,r):0:12 ',';);
 167      loop(j,put a0(j):0:12 ',';);
 168      loop(j,put ep(j):0:12 ',';);
 169      loop(j,put ea(j):0:12 ',';);
 170      loop(j,put qmin(j):0:12 ',';);
 171      loop((r,j),put speed(r,j):0:12 ',';);
 172      loop(j,put basePrice(s,j):0:12 ',';);
 173      loop(j,put baseInput(s,j):0:12 ',';);
 174      loop(j,put bestBound(s,j):0:12 ',';);
 175      put q0:0:12 /;
 176  );
 177  putclose f;
 178   
 179  File h /'results/base_starts.csv'/;
 180  h.pw = 32767;
 181  h.nz = 0;
 182  put h 'scenario_id,start_id,';
 183  loop(j,put 'initial_' j.tl:0 ',';);
 184  loop(j,put 'q_' j.tl:0 ',';);
 185  put 'objective_rub,modelstat,solvestat,max_violation,raw_violation_t,line_violation_hours,bound_violation_t,objective_check_rub,accepted,pass,status' /;
 186  loop((s,st),
 187      put s.tl:0 ',' st.tl:0 ',';
 188      loop(j,put startQ(s,st,j):0:12 ',';);
 189      loop(j,put runQ(s,st,j):0:12 ',';);
 190      put run(s,st,'objective_rub'):0:12 ',' run(s,st,'modelstat'):0:0 ',' run(s,st,'solvestat'):0:0 ',';
 191      put run(s,st,'max_violation'):0:12 ',' run(s,st,'raw_violation_t'):0:12 ',';
 192      put run(s,st,'line_violation_hours'):0:12 ',' run(s,st,'bound_violation_t'):0:12 ',';
 193      put run(s,st,'objective_check_rub'):0:12 ',' run(s,st,'accepted'):0:0 ',' run(s,st,'pass'):0:0 ',LOCAL_OPTIMUM_FOUND' /;
 194  );
 195  putclose h;
 196   
 197  display result, bestQ, basePrice, baseInput, bestShadow;
