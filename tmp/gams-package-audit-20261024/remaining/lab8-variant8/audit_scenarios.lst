   8      p0(j) /milk 24000, kefir 27000, cream 138000, curds 78000/
   9      a0(j) /milk 1.01, kefir 1.01, cream 9.45, curds 14/
  10      ep(j) /milk -.034, kefir -.022, cream -.022, curds -.027/
  11      ea(j) /milk -.017, kefir -.012, cream -.011, curds -.010/
  12      qmin(j) /milk 25, kefir 30, cream 1.5, curds 1.25/
