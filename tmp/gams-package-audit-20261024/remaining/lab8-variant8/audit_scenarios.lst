INCLUDE    C:\sarychev\Codex\magistratura\tmp\gams-package-audit-20261024\remaining\lab8-variant8\run_cases.inc
  65  Sets st /start1*start3/, pass /normal, strict/;
  66  Table initial(st,j)
  67               milk   kefir  cream  curds
  68      start1     25      30    1.5   1.25
  69      start2    300     500     30      5
  70      start3    800     100     45     35;
  71   
  72  Parameters result(s,*), bestQ(s,j), run(s,st,*), runQ(s,st,j),
  73      startQ(s,st,j), startUpper(j), used(r), bestShadow(s,*), bestBound(s,j), basePrice(s,j), baseInput(s,j);
  74  Scalars best, spread, objSpread, qSpread, violation, rawUsed, boundViolation,
  75      rawViolation, lineViolation, objectiveCheck, accepted;
  76   
  77  loop(s,
  78      rawCapacity = conditions(s,'raw_t');
  79      hours('mainline') = conditions(s,'mk_hours');
  80      hours('creamline') = conditions(s,'cream_hours');
  81      hours('curdsline') = conditions(s,'curds_hours');
  82      price('milk') = conditions(s,'p_milk');
  83      price('kefir') = conditions(s,'p_kefir');
  84      price('cream') = conditions(s,'p_cream');
  85      price('curds') = conditions(s,'p_curds');
  86      startUpper(j) = smin(r$speed(r,j),speed(r,j)*hours(r));
  87      abort$(smin(j,startUpper(j)-qmin(j))<0) 'Lower bound exceeds line capacity',s;
  88      spread = 0;
  89      loop(pass$(ord(pass)=1 or spread>.001),
  90          dairy.optfile = ord(pass);
  91          best = -inf;
  92          loop(st,
  93              q.l(j) = min(startUpper(j),max(qmin(j),initial(st,j)));
  94              startQ(s,st,j) = q.l(j);
  95              q.m(j) = 0;
  96              revenue.l = sum(j,price(j)*q0*rPower(q.l(j)/q0,1+ep(j)))/1e6;
  97              revenue.m = 0; raw.m = 0; line.m(r) = 0; objective.m = 0;
  98              solve dairy using nlp maximizing revenue;
  99              rawUsed = sum(j,a0(j)*q0*rPower(q.l(j)/q0,1+ea(j)));
 100              used(r) = sum(j,time(r,j)*q.l(j));
 101              rawViolation = max(0,rawUsed-rawCapacity);
 102              lineViolation = smax(r,max(0,used(r)-hours(r)));
 103              boundViolation = smax(j,max(0,qmin(j)-q.l(j),q.l(j)-q.up(j)));
 104              violation = max(rawViolation,lineViolation,boundViolation);
 105              objectiveCheck = abs(revenue.l*1e6-sum(j,price(j)*q0*rPower(q.l(j)/q0,1+ep(j))));
 106              accepted = ((dairy.modelstat=1 or dairy.modelstat=2) and dairy.solvestat=1 and violation<1e-5 and objectiveCheck<.01);
 107              run(s,st,'objective_rub') = revenue.l*1e6;
 108              run(s,st,'modelstat') = dairy.modelstat;
 109              run(s,st,'solvestat') = dairy.solvestat;
 110              run(s,st,'max_violation') = violation;
 111              run(s,st,'raw_violation_t') = rawViolation;
 112              run(s,st,'line_violation_hours') = lineViolation;
 113              run(s,st,'bound_violation_t') = boundViolation;
 114              run(s,st,'objective_check_rub') = objectiveCheck;
 115              run(s,st,'accepted') = accepted;
 116              run(s,st,'pass') = ord(pass);
 117              runQ(s,st,j) = q.l(j);
 118              if(accepted and revenue.l>best,
 119                  best = revenue.l;
 120                  bestQ(s,j) = q.l(j);
 121                  result(s,'objective_rub') = revenue.l*1e6;
 122                  result(s,'modelstat') = dairy.modelstat;
 123                  result(s,'solvestat') = dairy.solvestat;
 124                  result(s,'max_violation') = violation;
 125                  result(s,'raw_used_t') = rawUsed;
 126                  result(s,'mk_used_hours') = used('mainline');
 127                  result(s,'cream_used_hours') = used('creamline');
 128                  result(s,'curds_used_hours') = used('curdsline');
 129                  result(s,'raw_violation_t') = rawViolation;
 130                  result(s,'mk_violation_hours') = max(0,used('mainline')-hours('mainline'));
 131                  result(s,'cream_violation_hours') = max(0,used('creamline')-hours('creamline'));
 132                  result(s,'curds_violation_hours') = max(0,used('curdsline')-hours('curdsline'));
 133                  result(s,'bound_violation_t') = boundViolation;
 134                  result(s,'objective_check_rub') = objectiveCheck;
 135                  bestShadow(s,'raw') = raw.m*1e6;
 136                  loop(r,bestShadow(s,r) = line.m(r)*1e6;);
 137                  bestBound(s,j) = q.m(j)*1e6;
 138                  basePrice(s,j) = price(j)*rPower(q.l(j)/q0,ep(j));
 139                  baseInput(s,j) = a0(j)*rPower(q.l(j)/q0,ea(j));
 140              );
 141          );
 142          abort$(smin(st,run(s,st,'accepted'))=0) 'At least one start failed. Inspect listing.',s,run;
 143          objSpread = (smax(st,run(s,st,'objective_rub'))-smin(st,run(s,st,'objective_rub')))/max(1,abs(result(s,'objective_rub')));
 144          qSpread = smax(j,(smax(st,runQ(s,st,j))-smin(st,runQ(s,st,j)))/max(1,abs(bestQ(s,j))));
 145          spread = max(objSpread,qSpread);
 146          result(s,'pass') = ord(pass);
 147      );
 148      result(s,'spread_relative') = spread;
 149      result(s,'objective_spread_relative') = objSpread;
 150      result(s,'q_spread_relative') = qSpread;
 151      abort$(spread>.001) 'Starts still differ by more than 0.1 percent after stricter retry',s,spread;
 152  );
