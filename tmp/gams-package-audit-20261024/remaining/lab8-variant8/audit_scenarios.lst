INCLUDE    C:\sarychev\Codex\magistratura\tmp\gams-package-audit-20261024\remaining\lab8-variant8\export_results.inc
 155  Sets cf /raw_t,mk_hours,cream_hours,curds_hours,p_milk,p_kefir,p_cream,p_curds/,
 156      rf /objective_rub,modelstat,solvestat,max_violation,spread_relative,
