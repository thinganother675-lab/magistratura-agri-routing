 160   
 161  File f /'results/scenario_results.csv'/;
 162  f.pw = 32767;
 163  f.nz = 0;
 164  put f 'scenario_id,';
 165  loop(cf,put cf.tl:0 ',';);
 166  loop(j,put 'q_' j.tl:0 ',';);
 167  loop(rf,put rf.tl:0 ',';);
 168  put 'status,shadow_raw_rub_per_t,';
 169  loop(r,put 'shadow_' r.tl:0 '_rub_per_hour,';);
 170  loop(j,put 'a0_' j.tl:0 ',';);
 171  loop(j,put 'ep_' j.tl:0 ',';);
 172  loop(j,put 'ea_' j.tl:0 ',';);
 173  loop(j,put 'qmin_' j.tl:0 ',';);
 174  loop((r,j),put 'speed_' r.tl:0 '_' j.tl:0 ',';);
 175  loop(j,put 'effective_price_' j.tl:0 ',';);
 176  loop(j,put 'effective_input_' j.tl:0 ',';);
 177  loop(j,put 'bound_marginal_' j.tl:0 '_rub_per_t,';);
 178  put 'q0_t' /;
 179  loop(s,
 180      put s.tl:0 ',';
 181      loop(cf,put conditions(s,cf):0:12 ',';);
 182      loop(j,put bestQ(s,j):0:12 ',';);
 183      loop(rf,put result(s,rf):0:12 ',';);
 184      put 'LOCAL_OPTIMUM_FOUND,' bestShadow(s,'raw'):0:12 ',';
 185      loop(r,put bestShadow(s,r):0:12 ',';);
 186      loop(j,put a0(j):0:12 ',';);
 187      loop(j,put ep(j):0:12 ',';);
 188      loop(j,put ea(j):0:12 ',';);
 189      loop(j,put qmin(j):0:12 ',';);
 190      loop((r,j),put speed(r,j):0:12 ',';);
 191      loop(j,put basePrice(s,j):0:12 ',';);
 192      loop(j,put baseInput(s,j):0:12 ',';);
 193      loop(j,put bestBound(s,j):0:12 ',';);
 194      put q0:0:12 /;
 195  );
 196  putclose f;
 197   
 198  File h /'results/scenario_starts.csv'/;
 199  h.pw = 32767;
 200  h.nz = 0;
 201  put h 'scenario_id,start_id,';
 202  loop(j,put 'initial_' j.tl:0 ',';);
 203  loop(j,put 'q_' j.tl:0 ',';);
 204  put 'objective_rub,modelstat,solvestat,max_violation,raw_violation_t,line_violation_hours,bound_violation_t,objective_check_rub,accepted,pass,status' /;
 205  loop((s,st),
 206      put s.tl:0 ',' st.tl:0 ',';
 207      loop(j,put startQ(s,st,j):0:12 ',';);
 208      loop(j,put runQ(s,st,j):0:12 ',';);
 209      put run(s,st,'objective_rub'):0:12 ',' run(s,st,'modelstat'):0:0 ',' run(s,st,'solvestat'):0:0 ',';
 210      put run(s,st,'max_violation'):0:12 ',' run(s,st,'raw_violation_t'):0:12 ',';
 211      put run(s,st,'line_violation_hours'):0:12 ',' run(s,st,'bound_violation_t'):0:12 ',';
 212      put run(s,st,'objective_check_rub'):0:12 ',' run(s,st,'accepted'):0:0 ',' run(s,st,'pass'):0:0 ',LOCAL_OPTIMUM_FOUND' /;
 213  );
 214  putclose h;
 215   
 216  display result, bestQ;
