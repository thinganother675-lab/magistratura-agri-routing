  20  mk_time_80                   1400.00000000       16.80000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  21  mk_time_90                   1400.00000000       18.90000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  22  mk_time_110                  1400.00000000       23.10000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  23  cy_time_80                   1400.00000000       21.00000000       14.40000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  24  cy_time_90                   1400.00000000       21.00000000       16.20000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  25  cy_time_110                  1400.00000000       21.00000000       19.80000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  26  milk_price_90                1400.00000000       21.00000000       18.00000000    21600.00000000    27000.00000000   138000.00000000    22000.00000000
  27  milk_price_110               1400.00000000       21.00000000       18.00000000    26400.00000000    27000.00000000   138000.00000000    22000.00000000
  28  kefir_price_90               1400.00000000       21.00000000       18.00000000    24000.00000000    24300.00000000   138000.00000000    22000.00000000
  29  kefir_price_110              1400.00000000       21.00000000       18.00000000    24000.00000000    29700.00000000   138000.00000000    22000.00000000
  30  cream_price_90               1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   124200.00000000    22000.00000000
  31  cream_price_110              1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   151800.00000000    22000.00000000
  32  yogurt_price_90              1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    19800.00000000
  33  yogurt_price_110             1400.00000000       21.00000000       18.00000000    24000.00000000    27000.00000000   138000.00000000    24200.00000000
  34  combined                     1540.00000000       18.90000000       19.80000000    24000.00000000    27000.00000000   138000.00000000    22000.00000000
  35  ;
  36  Parameter a0(j) /milk 1.01,kefir 1.01,cream 9.45,yogurt .9/,
  37   ep(j) /milk -.033,kefir -.034,cream -.060,yogurt -.051/,
  38   ea(j) /milk -.020,kefir -.012,cream -.019,yogurt -.014/,
  39   lower(j) /milk 25,kefir 30,cream 1.5,yogurt 1/,
  40   initial(j) /milk 300,kefir 500,cream 30,yogurt 5/,
  41   p0(j),pcol(j,*), rep(s,*),starts(s,st,*);
  42  Scalar available,tm,ts,violation,best,spread;
  43  Positive Variables q(j),t(j);
  44  Variable z;
  45  Equations obj,raw,mk,cy,cobj,craw,cmk,ccy;
  46  obj.. z =e= sum(j,p0(j)*100*rPower(q(j)/100,1+ep(j)))/1e6;
  47  raw.. sum(j,a0(j)*100*rPower(q(j)/100,1+ea(j))) =l= available;
  48  mk.. q('milk')/50+q('kefir')/60 =l= tm;
  49  cy.. q('cream')/3+q('yogurt')/2 =l= ts;
  50  cobj.. z =e= sum(j,p0(j)*100*rPower(t(j)/a0(j),(1+ep(j))/(1+ea(j))))/1e6;
  51  craw.. sum(j,100*t(j)) =l= available;
  52  cmk.. 100*rPower(t('milk')/a0('milk'),1/(1+ea('milk')))/50
  53       +100*rPower(t('kefir')/a0('kefir'),1/(1+ea('kefir')))/60 =l= tm;
  54  ccy.. 100*rPower(t('cream')/a0('cream'),1/(1+ea('cream')))/3
  55       +100*rPower(t('yogurt')/a0('yogurt'),1/(1+ea('yogurt')))/2 =l= ts;
  56  Model original /obj,raw,mk,cy/,convex /cobj,craw,cmk,ccy/;
  57  option nlp=conopt,limrow=0,limcol=0,optcr=1e-9,optca=1e-9,reslim=60;
  58  q.lo(j)=lower(j);
  59  loop(s,
  60   available=cond(s,'raw_t'); tm=cond(s,'mk_hours'); ts=cond(s,'cy_hours');
  61   p0('milk')=cond(s,'p_milk');p0('kefir')=cond(s,'p_kefir');
  62   p0('cream')=cond(s,'p_cream');p0('yogurt')=cond(s,'p_yogurt');
  63   q.up('milk')=50*tm;q.up('kefir')=60*tm;
  64   q.up('cream')=3*ts;q.up('yogurt')=2*ts;
  65   best=-inf;
  66   loop(st,
  67    q.l(j)=lower(j)+(0.2+0.3*(ord(st)-1))*(initial(j)-lower(j));
  68    q.m(j)=0; z.l=0; z.m=0;
  69    solve original using nlp maximizing z;
  70    abort$((original.modelstat<>1 and original.modelstat<>2) or original.solvestat<>1) 'NLP failed',s,st;
  71    violation=max(0,sum(j,a0(j)*100*rPower(q.l(j)/100,1+ea(j)))-available,
  72     q.l('milk')/50+q.l('kefir')/60-tm,q.l('cream')/3+q.l('yogurt')/2-ts,
  73     smax(j,lower(j)-q.l(j)));
  74    abort$(violation>1e-5) 'NLP infeasible',s,st,violation;
  75    starts(s,st,'obj')=z.l*1e6;
  76    starts(s,st,'modelstat')=original.modelstat;starts(s,st,'solvestat')=original.solvestat;
  77    starts(s,st,'violation')=violation;
  78    loop(j,starts(s,st,j)=q.l(j););
  79    if(z.l>best,
  80     best=z.l;loop(j,rep(s,j)=q.l(j););
  81     rep(s,'obj')=z.l*1e6;
  82     rep(s,'modelstat')=original.modelstat;rep(s,'solvestat')=original.solvestat;
  83     rep(s,'raw_shadow')=raw.m*1e6;rep(s,'mk_shadow')=mk.m*1e6;rep(s,'cy_shadow')=cy.m*1e6;
  84    );
  85   );
  86   spread=(smax(st,starts(s,st,'obj'))-smin(st,starts(s,st,'obj')))/rep(s,'obj');
  87   abort$(spread>.001) 'More than 0.1 percent start spread',s,spread;
  88   rep(s,'spread')=spread;
  89   t.lo(j)=a0(j)*rPower(lower(j)/100,1+ea(j));
  90   t.up(j)=a0(j)*rPower(q.up(j)/100,1+ea(j));
  91   t.l(j)=a0(j)*rPower(rep(s,j)/100,1+ea(j));
  92   solve convex using nlp maximizing z;
  93   abort$((convex.modelstat<>1 and convex.modelstat<>2) or convex.solvestat<>1) 'Transformed NLP failed',s;
  94   rep(s,'convex_obj')=z.l*1e6;
  95   rep(s,'convex_modelstat')=convex.modelstat;rep(s,'convex_solvestat')=convex.solvestat;
  96   abort$(abs(rep(s,'obj')-rep(s,'convex_obj'))/rep(s,'obj')>1e-6) 'Transformed objective mismatch',s;
  97  );
  98  File f /'../results/lab8_gams_scenarios.csv'/;
  99  f.pw=32767;
 100  put f 'scenario_id,raw_t,mk_hours,cy_hours,p_milk,p_kefir,p_cream,p_yogurt,q_milk,q_kefir,q_cream,q_yogurt,objective_rub,modelstat,solvestat,start_spread_relative,convex_objective_rub,convex_modelstat,convex_solvestat,shadow_raw,shadow_mk,shadow_cy,status' /;
 101  loop(s,
 102   put s.tl:0 ',' cond(s,'raw_t'):0:8 ',' cond(s,'mk_hours'):0:8 ',' cond(s,'cy_hours'):0:8 ',';
 103   put cond(s,'p_milk'):0:8 ',' cond(s,'p_kefir'):0:8 ',' cond(s,'p_cream'):0:8 ',' cond(s,'p_yogurt'):0:8 ',';
 104   loop(j,put rep(s,j):0:10 ',';);
 105   put rep(s,'obj'):0:10 ',' rep(s,'modelstat'):0:0 ',' rep(s,'solvestat'):0:0 ',' rep(s,'spread'):0:12 ',';
 106   put rep(s,'convex_obj'):0:10 ',' rep(s,'convex_modelstat'):0:0 ',' rep(s,'convex_solvestat'):0:0 ',';
 107   put rep(s,'raw_shadow'):0:8 ',' rep(s,'mk_shadow'):0:8 ',' rep(s,'cy_shadow'):0:8 ',OPTIMUM_FOUND' /;
 108  );putclose f;
 109  File h /'../results/lab8_gams_starts.csv'/;
 110  h.pw=32767;
 111  put h 'scenario_id,start_id,q_milk,q_kefir,q_cream,q_yogurt,objective_rub,modelstat,solvestat,max_violation' /;
 112  loop((s,st),put s.tl:0 ',' st.tl:0 ',';loop(j,put starts(s,st,j):0:10 ',';);
 113   put starts(s,st,'obj'):0:10 ',' starts(s,st,'modelstat'):0:0 ',' starts(s,st,'solvestat'):0:0 ',' starts(s,st,'violation'):0:10 /;
 114  );putclose h;
 115  display rep;
