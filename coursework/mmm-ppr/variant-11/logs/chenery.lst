  65     (medium,high).gam    1.0       1.1       1.0
  66     (medium,high).xsi     .005      .0157     .00178;
  67   
  68  Parameter
  69     mew(t)  'intercept on import cost function'
  70     xsi(t)  'slope of import cost function'
  71     gam(t)  'intercept on export revenue function'
  72     alp(t)  'slope of export revenue function'
  73     ynot(i) 'demands in base year'
  74     sig(i)  'elasticity of substitution capital to labor'
  75     thet(i) 'price elasticity of demand'
  76     rho(i)  'substitution parameter in production functions'
  77     del(i)  'distribution parameter in production functions'
  78     efy(i)  'efficiency parameter in production functions';
  79   
  80  Scalar
  81     lbar    'total supply of labor' / 750 /
  82     plab    'price of labor'        /   1 /
  83     kbar    'capital stock'         / 500 /
  84     dbar    'trade deficit'         /   0 /;
  85   
  86  Variable
  87     x(i)    'quantity of output'
  88     v(i)    'value added per unit output at current prices'
  89     y(i)    'final consumption'
  90     p(i)    'prices'
  91     l(i)    'labor use per unit of output'
  92     k(i)    'capital use per unit of output'
  93     e(i)    'quantity of exports'
  94     m(i)    'quantity of imports'
  95     g(t)    'foreign exchange cost of imports'
  96     h(t)    'foreign exchange value of exports'
  97     pk      'nominal market price of capital'
  98     pi      'factor price ratio'
  99     pd      'price deflator'
 100     td      'total demand'
 101     vv(i)   'intermediate result';
 102   
 103  Positive Variable x, y, e, m, g, h, p, k, l, v;
 104   
 105  Equation
 106     dty     'total demand: definition'
 107     mb(i)   'material balance'
 108     tb      'trade balance'
 109     dg(t)   'definition of imports'
 110     dh(t)   'definition of exports'
 111     dem(i)  'demand equations'
 112     lc      'labor constraint'
 113     kc      'capital constraint'
 114     sup(i)  'supply equations'
 115     fpr     'factor price ratio definition'
 116     dvv(i)  'definition of vv'
 117     dl(i)   'definition of labor coefficient'
 118     dk(i)   'definition of capital coefficient'
 119     dv(i)   'value added';
 120   
 121  * The naming convention followed below is -
 122  * endogenous variables have 1 or 2 character names
 123  * exogenous parameters have 3 or more characters
 124   
 125  dty..    td   =e= sum(i, y(i));
 126   
 127  mb(i)..  x(i) =g= y(i) + sum(j, aio(i,j)*x(j)) + (e(i) - m(i))$t(i);
 128   
 129  tb..     sum(t, g(t)*m(t) - h(t)*e(t)) =l= dbar;
 130   
 131  dg(t)..  g(t) =e= mew(t) + xsi(t)*m(t);
 132   
 133  dh(t)..  h(t) =e= gam(t) - alp(t)*e(t);
 134   
 135  dem(i).. y(i) =e= ynot(i)*(pd*p(i))**thet(i);
 136   
 137  lc..     sum(i, l(i)*x(i)) =l= lbar;
 138   
 139  kc..     sum(i, k(i)*x(i)) =e= kbar;
 140   
 141  sup(i).. p(i) =e= sum(j, aio(j,i)*p(j)) + v(i);
 142   
 143  fpr..    pi   =e= pk/plab;
 144   
 145  dvv(i)$(sig(i) <> 0).. vv(i) =e= (pi*(1 - del(i))/del(i))**(-rho(i)/(1 + rho(i)));
 146   
 147  dl(i)..  l(i)*efy(i) =e= ((del(i)/vv(i) + (1 - del(i)))**(1/rho(i)))$(sig(i) <> 0) + 1$(sig(i) = 0);
 148   
 149  dk(i)..  k(i)*efy(i) =e= ((del(i) + (1 - del(i))*vv(i))**(1/rho(i)))$(sig(i) <> 0) + del(i)$(sig(i) = 0);
 150   
 151  dv(i)..  v(i) =e= pk*k(i) + plab*l(i);
 152   
 153  Model chenrad 'chenery raduchel model' / all /;
 154   
 155  * bounds for variables
 156  y.up(i)  = 2000;
 157  x.up(i)  = 2000;
 158  e.up(t)  =  400;
 159  m.up(t)  =  400;
 160  g.up(t)  =    4;
 161  h.up(t)  =    4;
 162  p.up(i)  =  100;
 163  p.lo(i)  =    0.1;
 164  l.up(i)  =    1;
 165  k.up(i)  =    1;
 166  pk.lo    =    0.25;
 167  pk.up    =    4;
 168  pi.lo    =    0.25;
 169  pi.up    =    4;
 170  v.up(i)  =  100;
 171  vv.lo(i) =    0.001;
 172   
 173  * select coefficient values for this run
 174  mew(t)  = 1.0;
 175  xsi(t)  = tdat("medium","xsi",t);
 176  gam(t)  = tdat("medium","gam",t);
 177  alp(t)  = tdat("medium","alp",t);
 178  ynot(i) = ddat("medium","ynot",i);
 179  thet(i) = ddat("medium","p-elas",i);
 180  sig(i)  = pdat("medium","a","subst",i);
 181  del(i)  = pdat("medium","a","distr",i);
 182  efy(i)  = pdat("medium","a","effic",i);
 183  rho(i)$(sig(i) <> 0) = 1./sig(i) - 1.;
 184   
 185  * initial values for variables
 186  y.l(i) = 250;
 187  x.l(i) = 200;
 188  e.l(t) =   0;
 189  m.l(t) =   0;
 190  g.l(t) = mew(t) + xsi(t)*m.l(t);
 191  h.l(t) = gam(t) - alp(t)*e.l(t);
 192  pd.l   =   0.3;
 193  p.l(i) =   3;
 194  pk.l   =   3.5;
 195  pi.l   = pk.l/plab;
 196   
 197  vv.l(i)$sig(i) = (pi.l*(1 - del(i))/del(i))**(-rho(i)/(1 + rho(i)));
 198   
 199  l.l(i) = (((del(i)/vv.l(i) + (1 - del(i)))**(1/rho(i)))$(sig(i) <> 0)
 200           + 1$(sig(i) = 0))/efy(i);
 201   
 202  k.l(i) = (((del(i) + (1 - del(i))*vv.l(i))**(1/rho(i)))$(sig(i) <> 0)
 203           + del(i)$(sig(i) = 0))/efy(i);
 204   
 205  v.l(i) = pk.l*k.l(i) + plab*l.l(i);
 206   
 207  * add bounds to avoid function evaluation errors
 208  pd.lo   = 0.01;
 209  p.lo(i) = 0.1;
 210   
 211  solve chenrad using nlp maximizing td;
 212   
 213  Scalar
 214     cva 'total value added at current prices'
 215     rva 'real value added'
 216     fve 'foreign exchange value of exports'
 217     emp 'total employment'
 218     cli 'cost of living index';
 219   
 220  cva = sum(i, v.l(i)*x.l(i));
 221  fve = sum(t, e.l(t)*h.l(t));
 222  emp = sum(i, l.l(i)*x.l(i));
 223  cli = sum(i, p.l(i)*ynot(i))/sum(i, ynot(i));
 224  rva = cva/cli;
 225   
 226  display cli, cva, rva, fve, emp;


