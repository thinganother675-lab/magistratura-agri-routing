Laboratory 10 - variant 11 - output-oriented VRS DEA for 25 firms
C o m p i l a t i o n


      Max phi with resource limits, expanded outputs, nonnegative intensities
      and sum(lambda)=1. Report efficiency k=1/phi. Zero y2 of firm9 retained.
      Output scale /1000 improves conditioning and changes neither phi nor k.
      Official model-library dea.gms is a structural reference; its input
      orientation is not silently substituted for the course's output model.
   9  Sets i /f1*f25/,m /lawyers,economists/,r /legal,reengineering/;
  10  Alias(i,j);
INCLUDE    C:\sarychev\Codex\magistratura\coursework\mmm-ppr\variant-11\models\dea-data.inc
  12  Table d(i,*)
  13                    y1          y2          x1          x2
  14  f1              2456         166          26           8
  15  f2              1377         244          16           7
  16  f3              2369         222          25           9
  17  f4              2361         271          25          10
  18  f5              1471         398          16          10
  19  f6              1954         185          20           8
  20  f7              1932         310          21           9
  21  f8              1869         171          20           7
  22  f9              2464           0          26           5
  23  f10              912         384          11           8
  24  f11             1096         331          12           8
  25  f12             1633         224          18           7
  26  f13              921         411          11           9
  27  f14             2591         357          27          12
  28  f15             1932         345          20          10
  29  f16             1400         186          16           6
  30  f17             1566         371          16          10
  31  f18             2194         545          23          14
  32  f19             2162          93          24           6
  33  f20             2794         158          29           9
  34  f21             1447         342          16           9
  35  f22             1536         495          16          12
  36  f23             2542         578          25          16
  37  f24             1465         343          16           9
  38  f25             2708         264          27          11
  39  ;
  40  Parameter x(i,m),y(i,r),xref(m),yref(r),report(i,*),peers(i,j);
  41  x(i,'lawyers')=d(i,'x1');x(i,'economists')=d(i,'x2');
  42  y(i,'legal')=d(i,'y1')/1000;y(i,'reengineering')=d(i,'y2')/1000;
  43  Positive Variable intensity(j);
  44  Variable phi;
  45  phi.lo=1;
  46  Equations inputs(m),outputs(r),convexity;
  47  inputs(m).. sum(j,x(j,m)*intensity(j)) =l= xref(m);
  48  outputs(r).. sum(j,y(j,r)*intensity(j)) =g= phi*yref(r);
  49  convexity.. sum(j,intensity(j)) =e= 1;
  50  Model dea /all/;
  51  option lp=cplex,limrow=0,limcol=0;
  52  Scalar violation;
  53  loop(i,
  54   xref(m)=x(i,m);yref(r)=y(i,r);
  55   intensity.l(j)=0;intensity.l(i)=1;phi.l=1;
  56   solve dea using lp maximizing phi;
  57   abort$(dea.modelstat<>1 or dea.solvestat<>1) 'DEA failed',i;
  58   violation=max(0,smax(m,sum(j,x(j,m)*intensity.l(j))-xref(m)),
  59    smax(r,phi.l*yref(r)-sum(j,y(j,r)*intensity.l(j))),
  60    abs(sum(j,intensity.l(j))-1),-smin(j,intensity.l(j)));
  61   abort$(violation>1e-7 or phi.l<1-1e-8) 'DEA invalid',i,violation;
  62   report(i,'phi')=phi.l;report(i,'k')=1/phi.l;
  63   report(i,'modelstat')=dea.modelstat;report(i,'solvestat')=dea.solvestat;
  64   report(i,'violation')=violation;peers(i,j)=intensity.l(j);
  65  );
  66  File f /'../results/lab10_gams_dea.csv'/;
  67  put f 'firm,phi,efficiency,modelstat,solvestat,max_violation' /;
  68  loop(i,put ord(i):0:0 ',' report(i,'phi'):0:12 ',' report(i,'k'):0:12 ',' report(i,'modelstat'):0:0 ',' report(i,'solvestat'):0:0 ',' report(i,'violation'):0:12 /;);
  69  putclose f;
  70  File g /'../results/lab10_gams_peers.csv'/;
  71  put g 'firm,peer,weight' /;
  72  loop((i,j)$(peers(i,j)>1e-8),put ord(i):0:0 ',' ord(j):0:0 ',' peers(i,j):0:12 /;);
  73  putclose g;
  74  display report;
