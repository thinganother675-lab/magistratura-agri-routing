  16                  milk    kefir    cream    curds
  17      mainline     .02        0        0        0
  18      creamline      0        0        0        0
  19      curdsline      0        0        0       .4;
  20  time('mainline','kefir') = 1/60;
  21  time('creamline','cream') = 1/3;
  22   
