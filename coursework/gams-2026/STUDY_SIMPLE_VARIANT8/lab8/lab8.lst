  24               milk   kefir  cream  curds
  25      start1     25      30    1.5   1.25
  26      start2    300     500     30      5
  27      start3    800     100     45     35;
  28   
  29  Table conditions(s,*)
  30           raw  mainline  creamline  curdsline   milk  kefir   cream  curds
  31      base 1400       21         18         18  24000  27000  138000  78000
  32      s01  1120       21         18         18  24000  27000  138000  78000
  33      s02  1260       21         18         18  24000  27000  138000  78000
  34      s03  1540       21         18         18  24000  27000  138000  78000
  35      s04  1680       21         18         18  24000  27000  138000  78000
  36      s05  1400       18         18         18  24000  27000  138000  78000
  37      s06  1400       24         18         18  24000  27000  138000  78000
  38      s07  1400       21         15         18  24000  27000  138000  78000
  39      s08  1400       21         21         18  24000  27000  138000  78000
  40      s09  1400       21         18         15  24000  27000  138000  78000
  41      s10  1400       21         18         21  24000  27000  138000  78000
  42      s11  1400       21         18         18  21600  27000  138000  78000
  43      s12  1400       21         18         18  26400  27000  138000  78000
  44      s13  1400       21         18         18  24000  24300  138000  78000
  45      s14  1400       21         18         18  24000  29700  138000  78000
  46      s15  1400       21         18         18  24000  27000  124200  78000
  47      s16  1400       21         18         18  24000  27000  151800  78000
  48      s17  1400       21         18         18  24000  27000  138000  70200
  49      s18  1400       21         18         18  24000  27000  138000  85800
  50      s19  1120       18         15         15  21600  24300  124200  70200
  51      s20  1680       24         21         21  26400  29700  151800  85800;
  52   
  53  Positive Variable x(j);
  54  Variable revenue;
  55  Equations objective, raw, resource(r);
  56  objective.. revenue =e= sum(j,price(j)*x(j)*rPower(x(j)/100,ep(j)))/1e6;
  57  raw.. sum(j,a0(j)*x(j)*rPower(x(j)/100,ea(j))) =l= rawCapacity;
  58  resource(r).. sum(j,time(r,j)*x(j)) =l= capacity(r);
  59  Model dairy /all/;
  60  x.lo(j) = minimum(j);
  61  option nlp=conopt, optcr=1e-9, optca=1e-9;
  62   
  63  File settings /conopt.opt/;
  64  put settings 'Tol_Feas_Max 1e-10' / 'Tol_Feas_Min 1e-12' / 'Tol_Optimality 1e-11' /;
  65  putclose settings;
  66  dairy.optfile = 1;
  67   
  68  loop(s,
  69      rawCapacity = conditions(s,'raw');
  70      capacity(r) = conditions(s,r);
  71      price(j) = conditions(s,j);
  72      loop(k,
  73          x.l(j) = initial(k,j);
  74          x.m(j) = 0;
  75          revenue.l = sum(j,price(j)*x.l(j)*rPower(x.l(j)/100,ep(j)))/1e6;
  76          solve dairy using nlp maximizing revenue;
  77          abort$((dairy.modelstat<>1 and dairy.modelstat<>2) or dairy.solvestat<>1) 'Solve failed: inspect lab8.lst',s,k;
  78          violation = max(0,sum(j,a0(j)*x.l(j)*rPower(x.l(j)/100,ea(j)))-rawCapacity);
  79          violation = max(violation,smax(r,sum(j,time(r,j)*x.l(j))-capacity(r)));
  80          violation = max(violation,smax(j,minimum(j)-x.l(j)));
  81          abort$(violation>1e-5) 'Constraint violated: inspect lab8.lst',s,k;
  82          plan(s,k,j) = x.l(j);
  83          result(s,k,'revenue') = revenue.l*1e6;
  84          result(s,k,'modelstat') = dairy.modelstat;
  85          result(s,k,'solvestat') = dairy.solvestat;
  86          result(s,k,'violation') = violation;
  87      );
  88      spread(s) = (smax(k,result(s,k,'revenue'))-smin(k,result(s,k,'revenue')))/max(1,abs(result(s,'start1','revenue')));
  89      spread(s) = max(spread(s),smax(j,(smax(k,plan(s,k,j))-smin(k,plan(s,k,j)))/max(1,abs(plan(s,'start1',j)))));
  90      abort$(spread(s)>.001) 'Starts differ >0.1 percent: tighten CONOPT tolerances and rerun',s;
  91  );
  92   
  93  File output /results.csv/;
  94  output.pw = 32767;
  95  output.nz = 0;
  96  put output 'case_id,start_id,raw_t,mainline_hours,creamline_hours,curdsline_hours,p_milk,p_kefir,p_cream,p_curds,x_milk,x_kefir,x_cream,x_curds,revenue_rub,modelstat,solvestat,max_violation,spread_relative' /;
  97  loop((s,k),
  98      put s.tl:0 ',' k.tl:0 ',' conditions(s,'raw'):0:12 ',';
  99      loop(r,put conditions(s,r):0:12 ',';);
 100      loop(j,put conditions(s,j):0:12 ',';);
 101      loop(j,put plan(s,k,j):0:12 ',';);
 102      put result(s,k,'revenue'):0:12 ',' result(s,k,'modelstat'):0:0 ',' result(s,k,'solvestat'):0:0 ',';
 103      put result(s,k,'violation'):0:12 ',' spread(s):0:12 /;
 104  );
 105  putclose output;
 106  display plan, result, spread;


