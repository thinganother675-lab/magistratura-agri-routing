C o m p i l a t i o n


   1  Sets
   2      r rows /rawmilk,mainline,creamline,assortment,obj/
   3      i(r) constraints /rawmilk,mainline,creamline,assortment/
   4      j columns /milk,kefir,cream,skim,sraw,sline,scream,sassort,rhs/
   5      v(j) variables /milk,kefir,cream,skim,sraw,sline,scream,sassort/
   6      p(j) products /milk,kefir,cream,skim/
   7      enter(j), leave(r), basic(r,j)
   8      it iteration_limit /it1*it100/;
   9  Alias (j,k);
  10  Parameters a(r,j), b(r), c(j), tab(r,j), prow(j), multiplier(r),
  11             ratio(r), solution(j), usage(r), slack(r);
  12  Scalars tol /1e-9/, iter /0/, eligible, enterOrder, leaveOrder,
  13          minratio, pivot, revenueSimplex, revenueDiff, maxViolation,
  14          basicError, expectedRevenue /321.517777777778/;
  15   
  16  a('rawmilk','milk')=1.01; a('rawmilk','kefir')=1.01;
  17  a('rawmilk','cream')=9.45; a('rawmilk','skim')=0.31;
  18  a('mainline','milk')=1/5; a('mainline','kefir')=1/6;
  19  a('mainline','skim')=1/6;
  20  a('creamline','cream')=1/0.3;
  21  a('assortment','kefir')=1; a('assortment','skim')=-2;
  22  b('rawmilk')=140; b('mainline')=21; b('creamline')=16;
  23  b('assortment')=0;
  24  c('milk')=2.4; c('kefir')=2.7; c('cream')=13.8; c('skim')=0.79;
  25  basic('rawmilk','sraw')=yes; basic('mainline','sline')=yes;
  26  basic('creamline','scream')=yes; basic('assortment','sassort')=yes;
  27  tab(i,j)=a(i,j); tab(i,j)$basic(i,j)=1;
  28  tab(i,'rhs')=b(i); tab('obj',v)=-c(v);
  29   
  30  File tables /simplex_tables.txt/;
  31  put tables;
  32  put 'COMPLETE PRIMAL SIMPLEX TABLEAUX - VARIANT 8'/;
  33  put 'Units: centners/day; revenue thousand RUB/day.'/;
  34  put 'Row: sum(tableau coefficients * variables) = RHS.'/;
  35  put 'Objective row: z + sum(objective coefficients * variables) = RHS.'/;
  36  put 'Bland order: milk,kefir,cream,skim,sraw,sline,scream,sassort.'/;
  37  put 'Entering: first negative objective coefficient; leaving: minimum ratio,'/;
  38  put 'ties: smallest ordered BASIC variable. Zero ratio pivots are allowed.'/;
  39  put 'Round only the displayed tables; internal arithmetic uses full precision.'/;
  40   
  41  put /'TABLE 0 - INITIAL'/;
  42  put 'Nonbasic: '; loop(v$(sum(i$basic(i,v),1)=0),put v.tl:12); put /;
  43  put 'row':14 'basic':12; loop(j,put j.tl:15); put /;
  44  loop(r,
  45      put r.tl:14;
  46      if(i(r),loop(j$basic(r,j),put j.tl:12); else put 'z':12;);
  47      loop(j,put tab(r,j):15:6); put /;
  48  );
  49   
  50  loop(it$(smin(v,tab('obj',v)) < -tol),
  51      iter=iter+1;
  52      enter(j)=no; leave(r)=no;
  53      enterOrder=smin(v$(tab('obj',v)<-tol),ord(v));
  54      enter(v)$(ord(v)=enterOrder)=yes;
  55      multiplier(r)=sum(j$enter(j),tab(r,j));
  56      eligible=sum(i$(multiplier(i)>tol),1);
  57      abort$(eligible=0) 'Unbounded LP detected';
  58      ratio(i)=inf;
  59      ratio(i)$(multiplier(i)>tol)=max(0,tab(i,'rhs'))/multiplier(i);
  60      minratio=smin(i,ratio(i));
  61      leaveOrder=smin((i,v)$(basic(i,v) and abs(ratio(i)-minratio)<tol),ord(v));
  62      leave(i)$(sum(v$(ord(v)=leaveOrder and basic(i,v)),1)>0)=yes;
  63      pivot=sum(i$leave(i),multiplier(i));
  64      abort$(abs(pivot)<tol or card(leave)<>1 or card(enter)<>1) 'Invalid pivot';
  65      put /'PIVOT ':0 iter:0:0 ': enter ';
  66      loop(j$enter(j),put j.tl:0);
  67      put ', leave '; loop((i,j)$(leave(i) and basic(i,j)),put j.tl:0);
  68      put ', pivot=' pivot:0:9 ', ratio=' minratio:0:9/;
  69      put 'Eligible ratios: ';
  70      loop(i$(multiplier(i)>tol),put i.tl:0 '=' ratio(i):0:9 '  '); put /;
  71      prow(j)=sum(i$leave(i),tab(i,j))/pivot;
  72      tab(r,j)=tab(r,j)-multiplier(r)*prow(j);
  73      tab(i,j)$leave(i)=prow(j);
  74      basic(i,j)$leave(i)=no;
  75      basic(i,j)$(leave(i) and enter(j))=yes;
  76   
  77      basicError=0;
  78      loop((i,k)$basic(i,k),
  79          basicError=max(basicError,abs(tab(i,k)-1),
  80              smax(r$(not sameas(i,r)),abs(tab(r,k))));
  81      );
  82      abort$(basicError>1e-7 or smin(i,tab(i,'rhs')) < -1e-7) 'Tableau invariant failed';
  83      put /'TABLE ' iter:0:0/;
  84      put 'Nonbasic: '; loop(v$(sum(i$basic(i,v),1)=0),put v.tl:12); put /;
  85      put 'row':14 'basic':12; loop(j,put j.tl:15); put /;
  86      loop(r,
  87          put r.tl:14;
  88          if(i(r),loop(j$basic(r,j),put j.tl:12); else put 'z':12;);
  89          loop(j,put tab(r,j):15:6); put /;
  90      );
  91  );
  92  abort$(smin(v,tab('obj',v)) < -tol) 'Iteration limit reached';
  93  solution(v)=sum(i$basic(i,v),tab(i,'rhs'));
  94  revenueSimplex=sum(p,c(p)*solution(p));
  95  usage(i)=sum(p,a(i,p)*solution(p)); slack(i)=b(i)-usage(i);
  96  maxViolation=max(0,smax(i,usage(i)-b(i)),-smin(v,solution(v)));
  97  abort$(maxViolation>1e-7 or abs(revenueSimplex-tab('obj','rhs'))>1e-7)
  98      'Original constraints or objective do not match tableau';
  99   
 100  Positive Variables x(p);
 101  Variable z;
 102  Equations referenceObjective, referenceConstraints(i);
 103  referenceObjective.. z =e= sum(p,c(p)*x(p));
 104  referenceConstraints(i).. sum(p,a(i,p)*x(p)) =l= b(i);
 105  Model reference /referenceObjective,referenceConstraints/;
 106  option lp=cplex;
 107  solve reference using lp maximizing z;
 108  abort$(reference.modelstat<>1 or reference.solvestat<>1) 'Reference LP failed';
 109  revenueDiff=abs(revenueSimplex-z.l);
 110  abort$(revenueDiff>1e-7 or smax(p,abs(solution(p)-x.l(p)))>1e-7
 111      or abs(revenueSimplex-expectedRevenue)>1e-7) 'Simplex differs from lab2 LP';
 112   
 113  put /'FINAL TABLE = TABLE ' iter:0:0/;
 114  put 'solution (product and slack variables):'/;
 115  loop(v,put v.tl:14 solution(v):18:9/);
 116  put 'Revenue, thousand RUB/day: ' revenueSimplex:0:9/;
 117  put 'Resource':16 'Limit':16 'Used':16 'Remaining':16/;
 118  loop(i,put i.tl:16 b(i):16:9 usage(i):16:9 slack(i):16:9/);
 119  put 'Verification: original constraints and nonnegativity PASS'/;
 120  put 'Verification: objective = CPLEX LP = original lab2 LP PASS'/;
 121  put 'CPLEX objective difference: ' revenueDiff:0:12/;
 122  put 'Maximum original constraint violation: ' maxViolation:0:12/;
 123  putclose tables;
 124  display solution,revenueSimplex,slack,iter,revenueDiff,maxViolation;
 125   


